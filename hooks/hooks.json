{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "py -3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\" 2>/dev/null || python3 \"${CLAUDE_PLUGIN_ROOT}/scripts/stop_hook.py\""
          }
        ]
      }
    ]
  }
}
